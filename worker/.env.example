# Postgres connection (use Supabase pooler URL, port 6543, sslmode=require)
WORKER_DB_URL=postgresql://postgres.ornnzinjrcyigazecctf:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Worker identity (free-form, helps debugging multi-instance)
WORKER_ID=answers-worker-local

# Job types this worker handles (comma separated)
WORKER_JOB_TYPES=rep_answers_generate

# Polling
POLL_INTERVAL_MS=2000
CLAIM_BATCH_SIZE=1
LOCK_SECONDS=600

# Health server
PORT=8080
LOG_LEVEL=info

# Provider keys (added in a later step)
PERPLEXITY_API_KEY=
LOVABLE_API_KEY=

# Safety
DAILY_TOKEN_BUDGET=2000000
MAX_CONCURRENT_JOBS=2
