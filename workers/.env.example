# Direct Postgres connection (NOT the pooler URL — graphile-worker needs LISTEN/NOTIFY)
# Found in Supabase dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase project URL and service-role key (used by task workers to call edge functions)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# How many jobs to run in parallel (tune based on Railway plan / edge function rate limits)
WORKER_CONCURRENCY=5

# Anon/publishable key — needed by congress_donor_backfill/refresh tasks.
# On the new API-key system this is the publishable key (sb_publishable_...), and the
# schedule-congress-donor-sync function compares apikey against it.
# Found in Supabase dashboard → Settings → API → Project API keys.
SUPABASE_ANON_KEY=eyJ...

# Cron secret — PRIMARY auth for edge functions gated by _shared/cron-auth.ts
# (drain-fec-finance, drain-research-queue, nightly-finance-reconciliation). The worker
# sends it as the x-cron-secret header. Required: the service-role-bearer fallback does NOT
# authorize these under the new API-key system. Fetch from Supabase Vault (SQL editor):
#   SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name = 'cron_secret';
CRON_SECRET=

# Per-state sync secrets — needed by state campaign finance and vote sync tasks.
# Fetch from Supabase Vault (run in SQL editor):
#   SELECT name, decrypted_secret FROM vault.decrypted_secrets
#   WHERE name IN ('nj_sync_secret','fl_sync_secret','ny_sync_secret','tx_sync_secret','vote_sync_secret');
NJ_SYNC_SECRET=
FL_SYNC_SECRET=
NY_SYNC_SECRET=
TX_SYNC_SECRET=
VOTE_SYNC_SECRET=
