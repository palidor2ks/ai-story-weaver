{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "bun install && bun build ./tasks/*.ts --outdir ./tasks --target bun"
  },
  "deploy": {
    "startCommand": "bun run worker.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

