# Copy to .env and fill in. These VITE_* values are PUBLIC — they ship in the
# frontend bundle, so it's fine that they're not secret. The Supabase
# publishable/anon key is meant to be public; row-level security protects data.
#
# NEVER put real secrets here (service_role key, API keys, DB passwords). Those
# belong only in the platform/server environment, not in any committed file.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
